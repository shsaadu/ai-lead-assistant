# Gemini API — https://aistudio.google.com (free, no card required)
GEMINI_API_KEY=your_gemini_api_key
# Optional: which Gemini model writes chat replies (default gemini-3.5-flash).
# Switch to a faster "flash-lite" model here if replies are slow.
# GEMINI_CHAT_MODEL=gemini-3.5-flash

# Supabase — https://supabase.com (free, no card required)
# Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Resend — https://resend.com (free, no card required)
# Dashboard -> API Keys
RESEND_API_KEY=your_resend_api_key
# Optional: only works once you verify your own sending domain in Resend.
# Until then, leave unset to use Resend's default onboarding sender.
RESEND_FROM_EMAIL=AI Lead Assistant <onboarding@resend.dev>

# Signs admin login sessions. Must be a long random string (32+ characters).
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs every admin out.
SESSION_SECRET=replace_with_a_long_random_string

# Optional: chat rate limits (defaults shown). Protects your free Gemini quota.
# CHAT_LIMIT_PER_MINUTE=15
# CHAT_LIMIT_PER_BUSINESS_PER_DAY=500
